# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Cartridge data (large binary files — don't commit)
cartridges/*.pkl
cartridges/*.npz
cartridges/*.npy
cartridges/*.json
cartridges/*.jsonl
data/*.pkl
data/*.npz
data/*.npy
data/*.json
data/*.jsonl

# Per-user Mempack storage path (cold-cut 2026-05-13: Mempacks now live in
# Supabase, but the cartridges/users/<uuid>/ tree may still hold legacy
# fixtures from before migration. Don't ship those publicly.)
cartridges/users/

# Exception: sample cartridge (small enough to include)
!cartridges/attention-is-all-you-need.cart.npz
!cartridges/attention-is-all-you-need.cart_manifest.json

# Model cache
model_cache/

# Downloaded source text caches
gutenberg_cache/

# Logs
*.log

# Internal docs — devlogs, pre-scope, and planning artifacts. Not intended
# for the public repo.
docs/DEVLOG.md
docs/DEVLOG-*.md
docs/*-PRE-SCOPE.md
docs/*-PLAN.md
docs/*-SCOPE.md
docs/internal/
docs/archived-for-future/

# Test artifacts — keep test scripts in git, ignore their output
tests/*_test_results/
tests/*_test_output/
tests/tmp/
tests/scratch/
tests/*.txt
tests/*_results.txt
tests/*-retest*.txt
test_*_results/
test_*_output/
federate_test_*/

# Vision sub-tree dev artifacts (untracked test scratch)
vision/test_carts/
vision/test_grid_cartridge_results.txt
vision/environment_files/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets
.env
.env.*
*.pem
*.key

# Virtual environments
venv/
.venv/
.venv/

# Runtime output of the ingest redaction filter (redact.append_review_log).
# Holds kinds, offsets and fingerprints -- never the credential value, verified -- but it
# is per-deployment operational data, not source, and it grows. Operators back it up with
# the carts; it does not belong in the repo.
redaction-review.jsonl

# Journal and sidecar artifacts left by test runs against a cart in the tree.
*.journal.jsonl
*.journal.jsonl.hwm
